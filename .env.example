# ---- Personal Chief of Staff — environment variables ----
# Copy to .env.local and fill in. Never commit real secrets.

# Set AI_OFFLINE=1 to disable all cloud AI and use deterministic fallbacks
# (heuristic classify, structured search, no STT/Vision/embeddings). Tests set
# this automatically; handy for fully-offline local/CI runs.
AI_OFFLINE=

# Anthropic (classify / advise / Vision)
ANTHROPIC_API_KEY=

# Postgres — the APP connects as a NON-SUPERUSER role so RLS is enforced.
# Local dev: `npm run db:up` starts Dockerised pgvector; use the pcos_app role.
#   e.g. postgresql://pcos_app:pcos_local_pw@localhost:5432/pcos
DATABASE_URL=

# Superuser URL used ONLY for migrations + admin cleanup (local dev/CI).
# In managed Postgres (Neon/Vercel) this can equal DATABASE_URL if that role
# owns the schema. Leave blank in production if the app role can migrate.
MIGRATE_DATABASE_URL=

# ---- Production: Neon (region us-east-1, to match Vercel iad1) ----
# IMPORTANT: Neon's default role `neondb_owner` has the BYPASSRLS attribute, so
# it IGNORES row-level security (FORCE RLS does not stop a BYPASSRLS role). Using
# it for the app would silently break tenant isolation. So we use TWO roles, as
# locally: a dedicated non-BYPASSRLS `pcos_app` role for the app, and
# `neondb_owner` for migrations only. Both strings end with ?sslmode=require.
#   DATABASE_URL          = pcos_app  + POOLED string (host contains "-pooler") — app runtime
#   MIGRATE_DATABASE_URL  = neondb_owner + DIRECT string (no "-pooler") — migrations/DDL
# Example (replace with your real values; pcos_app password from role setup):
#   DATABASE_URL=postgresql://pcos_app:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
#   MIGRATE_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# NOTE: set these in Vercel's env UI for production. Putting them in .env.local
# repoints LOCAL dev + tests away from Docker to Neon while they're set.

# Fixed dev tenant id (Phase 0; replaced by Clerk user id in Phase 5)
DEV_OWNER_ID=
# Optional: preview the second user's palette locally (aurora | sunrise)
DEV_THEME=

# Vercel Blob (captured images before Vision)
BLOB_READ_WRITE_TOKEN=

# Clerk auth (individual users — NOT Organizations).
# When these are unset, the app runs against the dev tenant (DEV_OWNER_ID).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Point Clerk at the in-app sign-in/up routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Web Push (VAPID) — primary notification channel — Phase 4/5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Alternate notification channels (per-user) — Phase 4
TELEGRAM_BOT_TOKEN=
PUSHOVER_TOKEN=
PUSHOVER_USER=

# OpenAI — used for Whisper-class STT (voice) AND embeddings (vector search).
# Code reads OPENAI_API_KEY, falling back to STT_API_KEY, so one OpenAI key
# can serve both. Set either one.
OPENAI_API_KEY=
# Voice capture (Whisper-class STT) — Phase 1. May hold your OpenAI key.
STT_API_KEY=

# Protect Vercel Cron routes — Phase 4
CRON_SECRET=

# ---- Phase 6: MCP connectors ----
# Encrypts per-user connector tokens at rest (AES-256-GCM). 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Tavily web search (FR20/FR21) — non-confidential queries only
TAVILY_API_KEY=
# Notion second-brain notes (FR31) — personal/dev only; office stays in Postgres
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=
# Mem0 (FR30) — optional; Postgres already backs memory
MEM0_API_KEY=
# Robinhood read-only investments (FR34) — official first-party MCP
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
